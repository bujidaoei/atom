# 复制成 .env 后填写。不要把 .env 提交进仓库。

# 本地开发可使用 development；Docker Compose 强制 production。
ATOM_ENVIRONMENT=development
# 分别执行两次 openssl rand -hex 32，填入不同随机值。留空会拒绝启动。
ATOM_SECRET=

# 数据落盘位置。Docker 里指向挂载卷。
ATOM_DATA_DIR=/data
ATOM_DB_PATH=/data/atom.db

# 快照存储：local 或 cos。COS 密钥只用于服务端，不会传给生成网页。
# 切换 COS 前须完成已有快照迁移和读写验证；不要只修改开关后直接上线。
ATOM_STORAGE_BACKEND=local
ATOM_UPLOAD_DIR=/app/uploads
ATOM_STORAGE_S3_ENDPOINT=
ATOM_STORAGE_S3_ACCESS_KEY=
ATOM_STORAGE_S3_SECRET_KEY=
ATOM_STORAGE_S3_BUCKET=
ATOM_STORAGE_S3_REGION=
# 使用应用独立前缀，避免与桶内其他业务文件混用。
ATOM_STORAGE_S3_PREFIX=
# 独立 HTTPS 网站入口；留空不会自动获得可用的网站地址。
ATOM_STORAGE_PUBLIC_URL_BASE=
# 默认功能检查不阻断发布；团队严格策略可设 required。
ATOM_PUBLICATION_VERIFICATION=advisory

# 模型网关（OpenAI 兼容）。用户可在设置页覆盖。
ATOM_LLM_BASE_URL=https://ai-gateway.skg.com/v1
ATOM_LLM_API_KEY=
ATOM_LLM_MODEL=deepseek-v4.1-flash
ATOM_LLM_TIMEOUT_SECONDS=300
ATOM_BUILD_BUDGET_SECONDS=180

# Node agent 运行时 sidecar
ATOM_RUNTIME_URL=http://127.0.0.1:8721
ATOM_RUNTIME_TOKEN=

# 生产必须 HTTPS，并将 SECURE 设为 true；false 仅用于本地 HTTP 开发。
ATOM_COOKIE_SECURE=false
ATOM_COOKIE_PATH=/
# 同 IP 多端口发布切换时，与独立预览入口一起启用；启用后旧会话需重新登录。
# 在独立预览入口完成前保持 false，避免同源生成脚本读取浏览器中的证明。
ATOM_CONSOLE_PROOF_REQUIRED=false

# 新用户初始额度
ATOM_STARTING_CREDITS=200

# 宿主机对外端口
ATOM_HTTP_PORT=80

# 独立发布站点返回 Atom 控制台的部署子路径；根目录部署时留空。
ATOM_CONTENT_CONSOLE_BASE_PATH=/atom

# 独立公网内容进程的 IP 端口模式。仅在预览隔离、控制台证明、TLS 入口
# 和外部可达性全部验收后启用；端口池在投产后不可缩减或改号。
ATOM_PUBLIC_DB_PATH=
ATOM_PUBLIC_ARTIFACT_DIR=
ATOM_PUBLIC_IP=
ATOM_PUBLIC_FIRST_PORT=
ATOM_PUBLIC_LAST_PORT=

# 独立预览进程。先保留关闭；须完成同 IP HTTPS 入站、浏览器隔离和旧预览切换验收。
# IP 与端口池须与已登记的项目端口账本一致，不得投产后改号或缩池。
ATOM_IP_PREVIEW_ENABLED=false
# 受信验收协调器先于控制台独立启动；控制台只访问私有 Docker 网络上的服务。
# 两个进程使用同一个一次性生成的控制令牌；不得写入仓库或浏览器配置。
# 正式启用前须完成目标机 COS 读取、真实用户验收和独立 HTTPS 入口检查。
# 启用时同时填写以下四项；未启用时不要设置为空值，否则配置校验会拒绝启动。
# ATOM_VERIFIER_ORIGIN=http://atom-verifier:8765
# ATOM_VERIFIER_CONTROL_TOKEN=
# ATOM_VERIFIER_POLICY_DIGEST=
# ATOM_VERIFIER_RUNNER_VERSION=
ATOM_VERIFIER_BUDGET_SECONDS=90
# 与预览隔离、控制台证明和外部 HTTPS 入口一同启用；禁用时保留旧 DNS 模式。
ATOM_IP_PUBLIC_ENABLED=false
ATOM_IP_PREVIEW_ADDRESS=
ATOM_IP_PREVIEW_FIRST_PORT=
ATOM_IP_PREVIEW_LAST_PORT=
# 仅私有/测试 CA 需要；生产公网证书使用系统信任库，留空即可。
ATOM_IP_INGRESS_CA_FILE=
ATOM_PREVIEW_DB_PATH=
ATOM_PREVIEW_ARTIFACT_DIR=
ATOM_PREVIEW_IP=
ATOM_PREVIEW_FIRST_PORT=
ATOM_PREVIEW_LAST_PORT=
