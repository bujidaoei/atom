# 复制成 .env 后填写。不要把 .env 提交进仓库。

# 会话签名密钥，生产环境必须换成随机值：openssl rand -hex 32
ATOM_SECRET=change-me-to-a-random-32-byte-hex

# 数据落盘位置。Docker 里指向挂载卷。
ATOM_DATA_DIR=/data
ATOM_DB_PATH=/data/atom.db

# 模型网关（OpenAI 兼容）。用户可在设置页覆盖。
ATOM_LLM_BASE_URL=https://ai-gateway.skg.com/v1
ATOM_LLM_API_KEY=
ATOM_LLM_MODEL=deepseek-v4.1-flash
ATOM_LLM_TIMEOUT_SECONDS=300
ATOM_BUILD_BUDGET_SECONDS=180

# Node agent 运行时 sidecar
ATOM_RUNTIME_URL=http://127.0.0.1:8721
ATOM_RUNTIME_TOKEN=change-me

# Cookie：HTTPS 部署时把 SECURE 打开
ATOM_COOKIE_SECURE=false
ATOM_COOKIE_PATH=/

# 新用户初始额度
ATOM_STARTING_CREDITS=200

# 宿主机对外端口
ATOM_HTTP_PORT=80
