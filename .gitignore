# secrets
.env
backend/.env

# dependencies
backend/.venv
frontend/node_modules
runtime/node_modules

# build output
frontend/dist
__pycache__/
.pytest_cache/
*.pyc

# Runtime state. These are anchored to the repository root on purpose: an
# unanchored `data/` also matched runtime/pi/packages/ai/src/providers/data,
# which silently dropped 43 vendored Pi files and broke the integrity check.
/backend/data/
/data/
/.logs/

# The vendored Pi tree and the pinned gateway bundle are part of the product
# and must stay in the repository; only the 157 MB per-generation build cache
# used to recompile the bundle is excluded.
runtime/.cache/pi-build-generation-*

.DS_Store
Thumbs.db
