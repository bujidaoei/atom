# Disposable Linux browser/API acceptance runner. Production containers do not
# contain pytest, browser-control packages or a Docker socket.
FROM mcr.microsoft.com/playwright/python:v1.58.0-noble-amd64@sha256:cd8493e380df200a471821e2690b710eab8d793dde3c0946fd0a39a961022914

COPY --from=ghcr.io/astral-sh/uv:0.11.14 /uv /uvx /bin/

WORKDIR /opt/atom-acceptance
COPY backend/pyproject.toml backend/uv.lock ./
ARG PYPI_INDEX=https://pypi.org/simple
RUN uv export --frozen --group dev --group browser --no-emit-project \
        --format requirements-txt -o /tmp/acceptance-requirements.txt \
    && uv venv \
    && uv pip install --index-url "$PYPI_INDEX" --require-hashes \
        -r /tmp/acceptance-requirements.txt \
    && rm /tmp/acceptance-requirements.txt

ENV PATH="/opt/atom-acceptance/.venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1
