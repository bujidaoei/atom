[Unit]
Description=Verify Atom console and committed project IP certificates
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/atom/origin-reconcile.env
ExecStart=/usr/bin/python3 ${ATOM_OPERATOR_ROOT}/deploy/ip_certificate_watch.py --config ${ATOM_CUTOVER_CONFIG} --publication-file ${ATOM_PUBLICATION_FILE}
TimeoutStartSec=120
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/run

