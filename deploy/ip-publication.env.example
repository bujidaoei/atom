# Host-side Compose substitutions for the protected IP-only cutover.
# Copy to a root-private path outside Git. Credentials stay in the separate
# ATOM_STORAGE_ENV_FILE, which must be mode 0600 and is never rendered to logs.
ATOM_PUBLICATION_IMAGE=
ATOM_CADDY_IMAGE=
ATOM_STORAGE_ENV_FILE=
ATOM_DATA_BIND=
ATOM_CADDY_CONFIG_DIR=
ATOM_CADDY_DATA_VOLUME=
ATOM_CADDY_CONFIG_VOLUME=
ATOM_PROXY_NETWORK=
ATOM_CADDY_PROXY_IP=
ATOM_PUBLIC_IP=
ATOM_FIRST_PORT=20000
ATOM_LAST_PORT=20127
