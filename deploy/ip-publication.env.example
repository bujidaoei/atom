# Host-side Compose substitutions for the protected IP-only cutover.
# Copy to a root-private path outside Git. Credentials stay in the separate
# ATOM_STORAGE_ENV_FILE, which must be mode 0600 and is never rendered to logs.
ATOM_PUBLICATION_IMAGE=
ATOM_CADDY_IMAGE=
ATOM_STORAGE_ENV_FILE=
ATOM_DATA_BIND=
ATOM_CADDY_CONFIG_DIR=
ATOM_CADDY_DATA_VOLUME=
ATOM_CADDY_CONFIG_VOLUME=
ATOM_PROXY_NETWORK=
ATOM_CADDY_PROXY_IP=
ATOM_PUBLIC_IP=
ATOM_FIRST_PORT=20000
ATOM_LAST_PORT=20127
ATOM_PREVIEW_UPSTREAM=atom-preview:8000
ATOM_PUBLIC_UPSTREAM=atom-public:8000
ATOM_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory

# 验收协调器使用专用 Docker bridge，只有控制台和验收服务加入。
# 在切换前创建该 bridge，并给新版控制台设置
# ATOM_VERIFIER_ORIGIN=http://atom-verifier:8765。
ATOM_VERIFIER_NETWORK=
ATOM_VERIFIER_WORKER_IMAGE=
ATOM_VERIFIER_ID=
ATOM_VERIFIER_POLICY_PATH=
ATOM_DOCKER_CLI_PATH=
# 指向独立的 root-private mode0600 文件，内含与控制台相同的控制令牌。
ATOM_VERIFIER_ENV_FILE=
