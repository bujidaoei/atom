[Unit]
Description=Start Atom API before its sandbox broker
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=210
ExecStart=/usr/local/sbin/atom-pair-restart

[Install]
WantedBy=multi-user.target
